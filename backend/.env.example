# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on
PORT=5000

# URL of the Next.js frontend, allowed by CORS (comma-separate multiple origins)
FRONTEND_URL=http://localhost:3000

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key with full database access. Backend only - never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
