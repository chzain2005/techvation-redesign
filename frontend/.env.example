# Copy this file to .env.local.
# Only NEXT_PUBLIC_ values are exposed to the browser: never put a secret in one.

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ (Admin > Data streams).
# Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=


# ---------------------------------------------------------------------------
# Payload CMS (admin dashboard at /admin)
# ---------------------------------------------------------------------------
# Database. Either a local SQLite file for quick development:
#   DATABASE_URI=file:./techvation.db
# or Supabase Postgres (Supabase > Connect > "Transaction pooler", port 6543).
# Write special characters in the password URL-encoded (e.g. @ as %40).
#   DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URI=file:./techvation.db

# Database connections per server process (Postgres only). Keep it small on
# Vercel: Supabase's pooler limits the total.
# DATABASE_POOL_MAX=3

# Long random string that signs admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# The public address of the site, e.g. https://thetechvation.com (used for
# admin links and previews). Optional locally.
NEXT_PUBLIC_SITE_URL=

# Image storage on Supabase Storage (S3 protocol). Leave empty to save
# uploads in /frontend/media (fine locally, NOT on Vercel).
# Supabase > Storage > Settings > S3 Connection; create a public bucket "media".
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CVs from job applications go to a separate PRIVATE bucket (Supabase >
# Storage > New bucket, "Public" switched OFF). Same keys as above.
S3_PRIVATE_BUCKET=
