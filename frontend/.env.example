# Copy this file to .env.local.
# Only NEXT_PUBLIC_ values are exposed to the browser. Never put the Supabase
# service role key here - it belongs in backend/.env only.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ (Admin > Data streams).
# Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=

